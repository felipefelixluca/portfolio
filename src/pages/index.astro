---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Metric from '../components/Metric.astro';

const projects = (await getCollection('projects', ({ data }) => data.status === 'published'))
  .sort((a, b) => a.data.order - b.data.order);

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Felipe Felix Castro — UX Design Leader, Tokyo">
  <!-- Hero -->
  <section class="relative">
    <div class="container-page pt-16 md:pt-24 pb-16 md:pb-28">
      <p class="eyebrow">UX Design Lead · Tokyo · Senior Manager · 14 years</p>

      <h1 class="mt-6 font-display font-bold text-display-2xl leading-[0.92]">
        Felipe <span class="inline-block align-baseline marker-square mb-3 md:mb-4" aria-hidden="true"></span><br />
        Felix <span class="text-bauhaus-red">Castro</span>.
      </h1>

      <div class="mt-10 md:mt-14 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-6">
        <p class="md:col-span-7 text-xl md:text-2xl leading-snug">
          Bridging visual craft, enterprise UX, and AI-assisted design.
          I lead a seven-person team at MetLife Japan and ship redesigns
          that move metrics — registration completion, time-to-complete,
          digital sales velocity — while building hands-on fluency in
          design-to-code workflows.
        </p>
        <div class="md:col-span-5 md:pl-8 md:border-l-2 md:border-ink">
          <p class="font-mono text-eyebrow uppercase tracking-[0.18em] text-muted">In a sentence</p>
          <p class="mt-2 font-display text-xl font-bold leading-tight">
            Process &gt; pixels. Outcomes &gt; opinions.
          </p>
          <a
            href={`${BASE}/Felipe_Felix_Castro_CV.pdf`}
            class="mt-6 inline-flex items-center gap-2 bg-ink text-paper px-5 py-3 font-mono text-xs uppercase tracking-[0.18em] hover:bg-bauhaus-red transition-colors"
          >
            Download CV (PDF)
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
    <!-- Bauhaus block accent -->
    <div class="absolute right-0 top-0 hidden lg:block" aria-hidden="true">
      <div class="flex">
        <span class="block h-24 w-24 bg-bauhaus-yellow"></span>
        <span class="block h-24 w-24 bg-bauhaus-blue"></span>
      </div>
    </div>
  </section>

  <!-- Metrics strip -->
  <section class="border-t-2 border-b-2 border-ink bg-paper">
    <div class="container-page py-12 md:py-16">
      <p class="eyebrow text-muted">Recent outcomes</p>
      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10">
        <Metric value="+30%" label="Customer registration completion · 2026" accent="red" />
        <Metric value="40% ↓" label="Time-to-complete · 2026" accent="yellow" />
        <Metric value="+40%" label="Faster digital sales · 2025" accent="blue" />
        <Metric value="+11%" label="Key procedure completion · 2025" accent="red" />
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="mt-16 md:mt-24">
    <div class="container-page">
      <div class="flex items-end justify-between gap-6">
        <div>
          <p class="eyebrow text-muted">Selected work</p>
          <h2 class="mt-3 font-display font-bold text-display-xl leading-[0.95]">
            Five projects.<br /> One operating belief.
          </h2>
        </div>
        <p class="hidden md:block max-w-xs text-sm text-muted">
          Each case study leads with the brief and the process. The screens come last.
        </p>
      </div>
    </div>

    <div class="mt-12 border-b-2 border-ink">
      {projects.map((p, i) => (
        <ProjectCard
          href={`${BASE}/work/${p.slug}`}
          title={p.data.title}
          client={p.data.client}
          role={p.data.role}
          year={p.data.year}
          summary={p.data.summary}
          index={i + 1}
          accent={p.data.accent}
        />
      ))}
    </div>
  </section>

  <!-- Operating belief -->
  <section class="mt-24 md:mt-32">
    <div class="container-page grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-5">
        <p class="eyebrow text-muted">How I work</p>
        <h2 class="mt-3 font-display font-bold text-display-lg">
          Design lives <br />inside delivery,<br /> not next to it.
        </h2>
      </div>
      <div class="md:col-span-7 space-y-6 text-lg leading-relaxed">
        <p>
          I lead UX inside DevOps and Scrum teams — research, prototyping, and validation folded
          into the same sprint rhythm as engineering. Journey maps and Value Proposition Canvas
          become short, in-the-flow working sessions for Claims, Call Center, and Customer Care
          partners, not 40-page artifacts filed away.
        </p>
        <p>
          The current frontier is design-to-code. Figma MCP, Claude Code, and GitHub Copilot
          are reshaping how a token decision in Figma reaches production — and the team
          process around it has to keep up. I'm building that programme internally and
          stress-testing it on a personal project that ships.
        </p>
      </div>
    </div>
  </section>
</Layout>
