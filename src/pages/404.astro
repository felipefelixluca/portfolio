---
import Layout from '../layouts/Layout.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Not found — Felipe Felix Castro">
  <section class="container-page py-32 md:py-40">
    <p class="eyebrow text-muted">404</p>
    <h1 class="mt-4 font-display font-bold text-display-2xl leading-[0.92]">
      Page <span class="text-bauhaus-red">not</span><br /> found.
    </h1>
    <p class="mt-8 max-w-prose text-xl">
      That route doesn't exist on this site. Try the work index or the about page.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href={`${BASE}/`} class="bg-ink text-paper px-5 py-3 font-mono text-xs uppercase tracking-[0.18em] hover:bg-bauhaus-red transition-colors">← Work</a>
      <a href={`${BASE}/about`} class="border-2 border-ink px-5 py-3 font-mono text-xs uppercase tracking-[0.18em] hover:bg-ink hover:text-paper transition-colors">About</a>
    </div>
  </section>
</Layout>
