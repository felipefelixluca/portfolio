---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Snapshot from '../../components/Snapshot.astro';
import Metric from '../../components/Metric.astro';
import Gallery from '../../components/Gallery.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const d = project.data;

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

const allProjects = (await getCollection('projects', ({ data }) => data.status === 'published'))
  .sort((a, b) => a.data.order - b.data.order);
const idx = allProjects.findIndex((p) => p.slug === project.slug);
const next = allProjects[(idx + 1) % allProjects.length];

const accentClass = {
  red: 'bg-bauhaus-red',
  yellow: 'bg-bauhaus-yellow',
  blue: 'bg-bauhaus-blue',
}[d.accent];

const accentTextClass = d.accent === 'yellow' ? 'text-ink' : 'text-paper';
---

<Layout title={`${d.title} — Felipe Felix Castro`}>
  <!-- Hero -->
  <section class="border-b-2 border-ink">
    <div class="container-page pt-12 md:pt-20 pb-16">
      <p class="eyebrow">
        <a href={`${BASE}/`} class="link-underline">← All work</a>
        <span class="mx-2 opacity-30">|</span>
        <span class="text-muted">{d.client} · {d.year}</span>
      </p>

      <h1 class="mt-6 font-display font-bold text-display-xl leading-[0.95] max-w-5xl">
        {d.title}
      </h1>

      <p class="mt-8 max-w-prose text-xl leading-relaxed">
        {d.summary}
      </p>

      <div class="mt-10">
        <Snapshot
          client={d.client}
          role={d.role}
          year={d.year}
          team={d.team}
          tools={d.tools}
        />
      </div>

      {d.metrics.length > 0 && (
        <div class="mt-10">
          <p class="eyebrow text-muted">Outcomes</p>
          <div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10">
            {d.metrics.map((m, i) => {
              const accents: ('red' | 'yellow' | 'blue' | 'ink')[] = ['red', 'yellow', 'blue', 'ink'];
              return <Metric value={m.value} label={m.label} accent={accents[i % accents.length]} />;
            })}
          </div>
        </div>
      )}

      {d.draftNote && (
        <p class="mt-8 inline-block border-2 border-ink px-3 py-2 font-mono text-eyebrow uppercase tracking-[0.18em] bg-bauhaus-yellow text-ink">
          Draft · {d.draftNote}
        </p>
      )}
    </div>
  </section>

  <!-- Body -->
  <article class="container-page py-16 md:py-24">
    <div class="case-prose mx-auto">
      <Content />
    </div>

    {d.gallery.length > 0 && (
      <div class="max-w-page mx-auto">
        <hr class="my-16" />
        <p class="eyebrow text-muted">Selected screens</p>
        <Gallery items={d.gallery} columns={d.galleryColumns} />
      </div>
    )}
  </article>

  <!-- Next project -->
  {next && (
    <a
      href={`${BASE}/work/${next.slug}`}
      class={`block ${accentClass} ${accentTextClass} hover:opacity-90 transition-opacity`}
    >
      <div class="container-page py-16 md:py-20 flex items-center justify-between gap-6">
        <div>
          <p class="font-mono text-eyebrow uppercase tracking-[0.18em] opacity-80">Next project →</p>
          <p class="mt-3 font-display text-display-lg font-bold leading-tight">{next.data.title}</p>
        </div>
        <span aria-hidden="true" class="font-display text-display-xl font-bold opacity-60">→</span>
      </div>
    </a>
  )}
</Layout>
