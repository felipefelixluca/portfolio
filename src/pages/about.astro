---
import Layout from '../layouts/Layout.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

const experience = [
  {
    role: 'Manager, UX Design',
    org: 'MetLife Japan',
    period: 'Jul 2023 — Present',
    bullets: [
      'Lead a 7-person design team (2 FTE + 5 vendors) supporting customer portals, agent sales platforms, and internal tools across multiple business lines.',
      'Redesigned the customer registration flow — +30% completion rate and 40% faster time-to-complete (2026).',
      'Led the agent sales platform redesign — 40% faster digital sales process, plus +11% completion on key procedures (2025); contributed to MetLife Japan hitting its annual NPS targets.',
      'Partner directly with Claims, Call Center, Customer Care, and IT — adapting journey mapping and Value Proposition Canvas into short, in-the-flow sessions that fit BAU delivery.',
      'Driving an internal design-to-code initiative (Figma MCP, Copilot, Claude Code) to reduce design-to-production lag; built an onboarding programme and a Power Automate intake workflow.',
    ],
  },
  {
    role: 'Assistant Manager, UX Design',
    org: 'MetLife Japan',
    period: 'May 2021 — Jul 2023',
    bullets: [
      'Embedded design-thinking into Agile delivery, partnering with business and engineering on journey mapping, prototyping, and behavioural data analysis.',
      'Shipped end-to-end UX on flows including customer registration (balancing OTP security against onboarding friction), claims billing preferences, and notification settings.',
    ],
  },
  {
    role: 'UI/UX Consultant',
    org: 'MetLife Japan',
    period: 'Jan 2020 — May 2021',
    bullets: [
      'Led UX for an agent-facing sales application — wireframes, prototypes, and high-fidelity layouts for new feature streams within a Scrum delivery cadence.',
    ],
  },
  {
    role: 'UI/UX Designer',
    org: 'Trifort Inc., Tokyo',
    period: 'Nov 2016 — Jan 2020',
    bullets: [
      'Service design across web and mobile for a multi-client portfolio: stakeholder engagement, concept presentation, and end-to-end design delivery.',
    ],
  },
];

const certifications = [
  { name: 'Google AI Essentials', meta: '2026' },
  { name: 'Microsoft Azure AI Fundamentals (AI-900)', meta: '2026' },
  { name: 'Accessibility: How to Design for All', meta: '40 hrs' },
  { name: 'How to Create Actionable User Journey Maps', meta: 'Masterclass' },
];

const tooling = {
  ai: ['Claude Code', 'Figma MCP', 'GitHub Copilot', 'Prompt-led prototyping'],
  design: ['Figma', 'Design systems', 'Journey mapping', 'Accessibility'],
  personal: ['Next.js', 'React', 'Tailwind', 'PostgreSQL', 'Railway'],
};

const languages = [
  { name: 'Portuguese', level: 'Native' },
  { name: 'English', level: 'Professional' },
  { name: 'Japanese', level: 'Professional' },
];
---

<Layout title="About — Felipe Felix Castro">
  <!-- Header -->
  <section class="container-page pt-16 md:pt-24 pb-12">
    <p class="eyebrow">About</p>
    <h1 class="mt-4 font-display font-bold text-display-xl leading-[0.95]">
      Senior design leader.<br />
      <span class="text-bauhaus-red">14 years</span>, six of them in enterprise UX.
    </h1>
    <p class="mt-8 max-w-prose text-xl leading-relaxed">
      Based in Tokyo. I lead a seven-person UX team at MetLife Japan, partnering with Claims,
      Call Center, Customer Care, and IT on a portfolio of customer- and agent-facing portals.
      Recent work includes a registration redesign (+30% completion, 40% faster) and a sales
      platform redesign that accelerated digital sales by 40%. I'm actively building hands-on
      fluency in AI-assisted design and design-to-code workflows.
    </p>
    <a
      href={`${BASE}/Felipe_Felix_Castro_CV.pdf`}
      class="mt-8 inline-flex items-center gap-2 bg-ink text-paper px-5 py-3 font-mono text-xs uppercase tracking-[0.18em] hover:bg-bauhaus-red transition-colors"
    >
      Download CV (PDF)
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <!-- Experience -->
  <section class="border-t-2 border-ink">
    <div class="container-page py-16">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
        <div class="md:col-span-3">
          <p class="eyebrow text-muted">Experience</p>
          <p class="mt-3 font-display text-2xl font-bold">2016 →</p>
        </div>
        <ol class="md:col-span-9 space-y-12">
          {experience.map((e) => (
            <li>
              <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-2 border-b-2 border-ink pb-3">
                <div>
                  <p class="font-display text-xl font-bold leading-tight">{e.role}</p>
                  <p class="font-mono text-eyebrow uppercase tracking-[0.18em] text-muted mt-1">{e.org}</p>
                </div>
                <p class="font-mono text-eyebrow uppercase tracking-[0.18em] text-muted">{e.period}</p>
              </div>
              <ul class="mt-4 space-y-2 text-base leading-relaxed">
                {e.bullets.map((b) => (
                  <li class="pl-6 relative">
                    <span class="absolute left-0 top-3 block w-3 h-[2px] bg-ink"></span>
                    {b}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Tools + certifications + languages -->
  <section class="border-t-2 border-ink">
    <div class="container-page py-16 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10">
      <div class="md:col-span-4">
        <p class="eyebrow text-muted">Tooling</p>
        <h3 class="mt-3 font-display text-2xl font-bold">AI & design-to-code</h3>
        <ul class="mt-4 space-y-1 font-mono text-sm">
          {tooling.ai.map((t) => <li>· {t}</li>)}
        </ul>
        <h3 class="mt-8 font-display text-2xl font-bold">Design</h3>
        <ul class="mt-4 space-y-1 font-mono text-sm">
          {tooling.design.map((t) => <li>· {t}</li>)}
        </ul>
        <h3 class="mt-8 font-display text-2xl font-bold">Personal stack</h3>
        <ul class="mt-4 space-y-1 font-mono text-sm">
          {tooling.personal.map((t) => <li>· {t}</li>)}
        </ul>
      </div>
      <div class="md:col-span-4">
        <p class="eyebrow text-muted">Certifications</p>
        <ul class="mt-4 space-y-4">
          {certifications.map((c) => (
            <li class="border-b-2 border-ink pb-3 flex items-baseline justify-between gap-4">
              <span class="font-display font-bold text-base leading-tight">{c.name}</span>
              <span class="font-mono text-eyebrow uppercase tracking-[0.18em] text-muted">{c.meta}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="md:col-span-4">
        <p class="eyebrow text-muted">Languages</p>
        <ul class="mt-4 space-y-4">
          {languages.map((l) => (
            <li class="border-b-2 border-ink pb-3 flex items-baseline justify-between gap-4">
              <span class="font-display font-bold text-base">{l.name}</span>
              <span class="font-mono text-eyebrow uppercase tracking-[0.18em] text-muted">{l.level}</span>
            </li>
          ))}
        </ul>
        <p class="mt-12 eyebrow text-muted">Education</p>
        <p class="mt-3 font-display text-lg font-bold">Bachelor of Graphic Design</p>
        <p class="font-mono text-eyebrow uppercase tracking-[0.18em] text-muted mt-1">Universidade FUMEC, Brazil · 2007 — 2011</p>
      </div>
    </div>
  </section>
</Layout>
