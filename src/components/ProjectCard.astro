---
interface Props {
  href: string;
  title: string;
  client: string;
  role: string;
  year: string;
  summary: string;
  index: number;
  accent?: 'red' | 'yellow' | 'blue';
}

const { href, title, client, role, year, summary, index, accent = 'red' } = Astro.props;

const accentBg = {
  red: 'bg-bauhaus-red',
  yellow: 'bg-bauhaus-yellow',
  blue: 'bg-bauhaus-blue',
}[accent];

const accentText = accent === 'yellow' ? 'text-ink' : 'text-paper';
const num = String(index).padStart(2, '0');
---

<a
  href={href}
  class="group block border-t-2 border-ink py-10 md:py-14 transition-colors hover:bg-ink hover:text-paper"
>
  <div class="container-page grid grid-cols-12 gap-6 items-start">
    <div class="col-span-2 md:col-span-1">
      <span class="font-mono text-eyebrow uppercase tracking-[0.18em] opacity-70">{num}</span>
    </div>
    <div class="col-span-10 md:col-span-7">
      <p class="eyebrow opacity-70 group-hover:text-paper">{client} · {year}</p>
      <h3 class="mt-2 text-display-lg font-display font-bold leading-tight">
        {title}
      </h3>
      <p class="mt-4 text-lg max-w-prose">
        {summary}
      </p>
      <p class="mt-4 font-mono text-eyebrow uppercase tracking-[0.18em] opacity-70 group-hover:text-paper">
        {role}
      </p>
    </div>
    <div class="hidden md:flex col-span-4 items-start justify-end gap-3">
      <span class={`inline-block h-3 w-3 ${accentBg}`} aria-hidden="true"></span>
      <span class="font-mono text-xs uppercase tracking-[0.16em] opacity-70 group-hover:opacity-100">
        Read case →
      </span>
    </div>
  </div>
</a>
