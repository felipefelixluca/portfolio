---
interface Props {
  value: string;
  label: string;
  accent?: 'red' | 'yellow' | 'blue' | 'ink';
}

const { value, label, accent = 'ink' } = Astro.props;

const dot = {
  red: 'bg-bauhaus-red',
  yellow: 'bg-bauhaus-yellow',
  blue: 'bg-bauhaus-blue',
  ink: 'bg-ink',
}[accent];
---

<div class="border-t-2 border-ink pt-4">
  <span class={`inline-block h-2 w-2 ${dot} mb-3`} aria-hidden="true"></span>
  <p class="font-display font-bold text-display-xl leading-none">{value}</p>
  <p class="mt-3 font-mono text-eyebrow uppercase tracking-[0.18em] text-muted">{label}</p>
</div>
