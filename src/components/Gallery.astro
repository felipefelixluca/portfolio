---
interface Props {
  items: { src: string; alt: string; caption?: string }[];
  columns?: 1 | 2 | 3;
}

const { items, columns = 2 } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

const colClass = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
}[columns];
---

<div class={`grid ${colClass} gap-6 md:gap-8 my-12`}>
  {items.map((item) => (
    <figure class="border-2 border-ink">
      <img
        src={item.src.startsWith('http') ? item.src : `${BASE}${item.src}`}
        alt={item.alt}
        loading="lazy"
        decoding="async"
        class="block w-full h-auto bg-paper"
      />
      {item.caption && (
        <figcaption class="border-t-2 border-ink px-4 py-3 font-mono text-xs uppercase tracking-[0.14em] text-muted">
          {item.caption}
        </figcaption>
      )}
    </figure>
  ))}
</div>
