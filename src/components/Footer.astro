---
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="mt-24 bg-ink text-paper">
  <div class="container-page py-16 md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-6">
      <div class="md:col-span-7">
        <p class="eyebrow text-paper opacity-70">My Contact</p>
        <h2 class="mt-3 text-display-xl font-display font-bold leading-none text-paper">
          Get in Touch
        </h2>
        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-lg">
          <a class="link-underline" href="mailto:felipefelixluca@gmail.com">felipefelixluca@gmail.com</a>
          <a class="link-underline" href="https://www.linkedin.com/in/felipefelixluca" target="_blank" rel="noopener">linkedin.com/in/felipefelixluca</a>
        </div>
      </div>
      <div class="md:col-span-5 md:text-right">
        <p class="eyebrow opacity-70">Currently</p>
        <p class="mt-3 text-xl font-display">Manager, UX Design — MetLife Japan</p>
        <p class="mt-1 text-sm opacity-70">Tokyo · +81 80-2187-9407</p>
        <a
          href={`${BASE}/Felipe_Felix_Castro_CV.pdf`}
          class="mt-6 inline-flex items-center gap-2 border-2 border-paper px-5 py-3 font-mono text-xs uppercase tracking-[0.18em] hover:bg-paper hover:text-ink transition-colors"
        >
          Download CV (PDF)
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <hr class="border-paper/40 my-12" />

    <div class="text-xs font-mono uppercase tracking-[0.16em] opacity-70">
      <p>© {year} Felipe Felix Castro</p>
    </div>
  </div>
</footer>
