---
// MetLife Customer Journey — 4 phases (Onboarding · IDM · Portal·Transaction · Follow-up)
// Redrawn from MetLife/journey.png. Channels, touchpoints, emotion (low/mid/high), pain points.

const phases = [
  {
    name: 'Onboarding',
    accent: 'bauhaus-red',
    channels: ['In-person agent'],
    touchpoints: ['Application form', 'Welcome packet'],
    emotion: 1, // 0 low, 1 mid, 2 high
    quote: '"I had no real reason to register the portal — did I really need to?"',
    pain: 'No clear value framing for digital sign-up at the moment of purchase.',
  },
  {
    name: 'IDM',
    accent: 'bauhaus-yellow',
    channels: ['Email', 'IDM'],
    touchpoints: ['Registration email', 'ID setup', 'OTP'],
    emotion: 0,
    quote: '"The email link kept failing — and OTP felt like overkill."',
    pain: 'Repeated OTP failures and unclear error states caused dropout.',
  },
  {
    name: 'Portal · Transaction',
    accent: 'bauhaus-blue',
    channels: ['Portal'],
    touchpoints: ['Contract overview', 'Beneficiary change', 'Procedure flows'],
    emotion: 1,
    quote: '"The screen is dense but the information I need is actually here."',
    pain: 'Information density made the right action hard to spot for new users.',
  },
  {
    name: 'Follow-up',
    accent: 'bauhaus-red',
    channels: ['Email', 'Portal'],
    touchpoints: ['Notification settings', 'Engagement messages'],
    emotion: 2,
    quote: '"Now I know where to go and what I can do without calling."',
    pain: 'Re-engagement depends on the customer remembering the portal exists.',
  },
];

const emotionLabel = ['Low', 'Mid', 'High'];
---

<figure class="my-12 border-2 border-ink">
  <figcaption class="border-b-2 border-ink bg-ink text-paper px-5 py-3 flex items-center justify-between">
    <span class="font-mono text-eyebrow uppercase tracking-[0.18em]">Customer journey · Customer Portal</span>
    <span class="font-mono text-eyebrow uppercase tracking-[0.18em] opacity-70 hidden md:inline">Front-end DX</span>
  </figcaption>

  <div class="bg-paper">
    {/* Desktop */}
    <div class="hidden md:block">
      <div class="grid grid-cols-4 divide-x-2 divide-ink">
        {phases.map((p) => (
          <div class="p-5">
            <div class="flex items-center gap-2">
              <span class={`block h-3 w-3 ${p.accent === 'bauhaus-yellow' ? 'bg-bauhaus-yellow' : p.accent === 'bauhaus-blue' ? 'bg-bauhaus-blue' : 'bg-bauhaus-red'}`}></span>
              <span class="font-mono text-eyebrow uppercase tracking-[0.18em] text-muted">Phase</span>
            </div>
            <p class="mt-1 font-display text-xl font-bold leading-tight">{p.name}</p>
            <p class="mt-4 font-mono text-eyebrow uppercase tracking-[0.18em] text-muted">Channel</p>
            <p class="text-sm">{p.channels.join(' · ')}</p>
            <p class="mt-3 font-mono text-eyebrow uppercase tracking-[0.18em] text-muted">Touchpoints</p>
            <ul class="text-sm">
              {p.touchpoints.map((t) => <li>· {t}</li>)}
            </ul>
          </div>
        ))}
      </div>

      {/* Emotion strip */}
      <div class="border-t-2 border-ink px-5 py-6">
        <p class="font-mono text-eyebrow uppercase tracking-[0.18em] text-muted mb-3">Emotion</p>
        <svg viewBox="0 0 400 80" class="w-full h-20" preserveAspectRatio="none" role="img" aria-label="Customer emotion curve across journey phases">
          <line x1="0" y1="20" x2="400" y2="20" stroke="#0A0A0A" stroke-width="0.5" stroke-dasharray="2 3" />
          <line x1="0" y1="40" x2="400" y2="40" stroke="#0A0A0A" stroke-width="0.5" stroke-dasharray="2 3" />
          <line x1="0" y1="60" x2="400" y2="60" stroke="#0A0A0A" stroke-width="0.5" stroke-dasharray="2 3" />
          {phases.map((p, i) => {
            const x = 50 + i * 100;
            const y = 60 - p.emotion * 20;
            return <circle cx={x} cy={y} r="6" fill="#0A0A0A" />;
          })}
          <path
            d={`M 50 ${60 - phases[0].emotion * 20} L 150 ${60 - phases[1].emotion * 20} L 250 ${60 - phases[2].emotion * 20} L 350 ${60 - phases[3].emotion * 20}`}
            stroke="#E2231A"
            stroke-width="2"
            fill="none"
          />
        </svg>
        <div class="grid grid-cols-4 mt-2 text-center font-mono text-[10px] uppercase tracking-[0.16em] text-muted">
          {phases.map((p) => <span>{emotionLabel[p.emotion]}</span>)}
        </div>
      </div>

      {/* Quotes / pain */}
      <div class="grid grid-cols-4 divide-x-2 divide-ink border-t-2 border-ink">
        {phases.map((p) => (
          <div class="p-5">
            <p class="text-sm italic">{p.quote}</p>
            <p class="mt-3 font-mono text-eyebrow uppercase tracking-[0.18em] text-bauhaus-red">Pain</p>
            <p class="text-sm">{p.pain}</p>
          </div>
        ))}
      </div>
    </div>

    {/* Mobile */}
    <ol class="md:hidden divide-y-2 divide-ink">
      {phases.map((p) => (
        <li class="p-5">
          <div class="flex items-center gap-2">
            <span class={`block h-3 w-3 ${p.accent === 'bauhaus-yellow' ? 'bg-bauhaus-yellow' : p.accent === 'bauhaus-blue' ? 'bg-bauhaus-blue' : 'bg-bauhaus-red'}`}></span>
            <p class="font-display text-lg font-bold">{p.name}</p>
          </div>
          <p class="mt-2 text-xs font-mono uppercase tracking-[0.18em] text-muted">{p.channels.join(' · ')}</p>
          <p class="mt-1 text-sm">{p.touchpoints.join(', ')}</p>
          <p class="mt-3 text-sm italic">{p.quote}</p>
          <p class="mt-3 font-mono text-eyebrow uppercase tracking-[0.18em] text-bauhaus-red">Pain</p>
          <p class="text-sm">{p.pain}</p>
        </li>
      ))}
    </ol>
  </div>
</figure>
